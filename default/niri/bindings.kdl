// Omarchy keybindings for Niri, translated from default/hypr/bindings/*.lua.

// Lid-switch handling (default/hypr/bindings/utilities.lua). This is a
// top-level switch-events node, not a keyboard bind -- and per niri's own
// docs, switch-event binds always run regardless of lock state, so
// Hyprland's { locked = true } option on these two has no niri property
// to port. lid-open's omarchy-hyprland-monitor-clamshell is Hyprland-
// specific (see config.kdl's autostart section for the full clamshell
// gap) and has no niri equivalent yet -- it will silently no-op here.
switch-events {
    lid-close { spawn "omarchy-system-lid-close"; }
    lid-open { spawn "omarchy-hyprland-monitor-clamshell"; }
}

binds {
    // This file ports each Hyprland binding to the same key combination
    // calling the same shell command, per this plan's mechanical-translation
    // scope (see the design spec). Some of these commands are internally
    // Hyprland-specific (call hyprctl directly, or read Hyprland's own
    // config/state) and will not work correctly -- or will silently no-op --
    // under Niri. This file does not attempt to audit or flag every such
    // case; identifying which bound commands actually need a niri-native
    // replacement is separate, later work (see this plan's own closing
    // Verification section, and the design spec's autostart section for the
    // same situation with omarchy-hyprland-monitor-watch).

    // ---- Applications (default/hypr/bindings/applications.lua) ----
    Mod+Return hotkey-overlay-title="Terminal" { spawn "omarchy-launch-terminal"; }
    Mod+Shift+Return hotkey-overlay-title="Browser" { spawn "omarchy-launch-browser"; }
    Mod+Shift+F hotkey-overlay-title="File manager" { spawn "omarchy-launch-nautilus"; }
    Mod+Alt+Shift+F hotkey-overlay-title="File manager (cwd)" { spawn "omarchy-launch-nautilus-cwd"; }
    Mod+Shift+B hotkey-overlay-title="Browser" { spawn "omarchy-launch-browser"; }
    Mod+Shift+Alt+B hotkey-overlay-title="Browser (private)" { spawn "omarchy-launch-browser" "--private"; }
    Mod+Shift+N hotkey-overlay-title="Editor" { spawn "omarchy-launch-editor"; }

    // The following app/webapp bindings are unconditional here; Hyprland's
    // config gates them on o.preinstalled_bindings_enabled() (a runtime
    // state-file check for whether preinstalled apps were removed), which
    // this static file can't replicate. Revisit if that ever needs porting.
    Mod+Alt+Return hotkey-overlay-title="Tmux" { spawn "omarchy-launch-terminal-tmux"; }
    Mod+Ctrl+Return hotkey-overlay-title="Herdr" { spawn "omarchy-launch-terminal-herdr"; }
    Mod+Shift+M hotkey-overlay-title="Music" { spawn "omarchy-launch-spotify"; }
    Mod+Shift+Alt+M hotkey-overlay-title="Music TUI" { spawn "omarchy-launch-or-focus-tui" "cliamp"; }
    Mod+Shift+D hotkey-overlay-title="Docker" { spawn "omarchy-launch-tui" "lazydocker"; }
    Mod+Shift+G hotkey-overlay-title="Signal" { spawn "omarchy-launch-signal"; }
    Mod+Shift+O hotkey-overlay-title="Obsidian" { spawn "omarchy-launch-or-focus" "^obsidian$" "uwsm-app -- obsidian"; }
    Mod+Shift+W hotkey-overlay-title="Omawrite" { spawn "uwsm-app" "--" "omawrite"; }
    Mod+Shift+Slash hotkey-overlay-title="Passwords" { spawn "omarchy-launch-1password"; }

    Mod+Shift+A hotkey-overlay-title="ChatGPT" { spawn "omarchy-launch-webapp" "https://chatgpt.com"; }
    Mod+Shift+Alt+A hotkey-overlay-title="Grok" { spawn "omarchy-launch-webapp" "https://grok.com"; }
    Mod+Shift+C hotkey-overlay-title="Calendar" { spawn "omarchy-launch-webapp" "https://app.hey.com/calendar/weeks/"; }
    Mod+Shift+E hotkey-overlay-title="Email" { spawn "omarchy-launch-webapp" "https://app.hey.com"; }
    Mod+Shift+Alt+E hotkey-overlay-title="New email" { spawn "omarchy-launch-webapp" "https://app.hey.com/messages/new?display=standalone&new_window=true"; }
    Mod+Shift+Y hotkey-overlay-title="YouTube" { spawn "omarchy-launch-webapp" "https://youtube.com/"; }
    Mod+Shift+Alt+G hotkey-overlay-title="WhatsApp" { spawn "omarchy-launch-or-focus-webapp" "WhatsApp" "https://web.whatsapp.com/"; }
    Mod+Shift+Ctrl+G hotkey-overlay-title="Google Messages" { spawn "omarchy-launch-or-focus-webapp" "Google Messages" "https://messages.google.com/web/conversations"; }
    Mod+Shift+P hotkey-overlay-title="Google Photos" { spawn "omarchy-launch-or-focus-webapp" "Google Photos" "https://photos.google.com/"; }
    Mod+Shift+S hotkey-overlay-title="Google Maps" { spawn "omarchy-launch-or-focus-webapp" "Google Maps" "https://maps.google.com/"; }
    Mod+Shift+X hotkey-overlay-title="X" { spawn "omarchy-launch-webapp" "https://x.com/"; }
    Mod+Shift+Alt+X hotkey-overlay-title="X Post" { spawn "omarchy-launch-webapp" "https://x.com/compose/post"; }

    // ---- Media, volume, brightness (default/hypr/bindings/media.lua) ----
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume up" { spawn "omarchy-audio-output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume down" { spawn "omarchy-audio-output-volume" "lower"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute" { spawn "omarchy-audio-output-volume" "mute-toggle"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute microphone" { spawn "omarchy-audio-input-mute"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness up" { spawn "omarchy-brightness-display" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness down" { spawn "omarchy-brightness-display" "5%-"; }
    Shift+XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness maximum" { spawn "omarchy-brightness-display" "100%"; }
    Shift+XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness minimum" { spawn "omarchy-brightness-display" "1%"; }
    XF86KbdBrightnessUp allow-when-locked=true hotkey-overlay-title="Keyboard brightness up" { spawn "omarchy-brightness-keyboard" "up"; }
    XF86KbdBrightnessDown allow-when-locked=true hotkey-overlay-title="Keyboard brightness down" { spawn "omarchy-brightness-keyboard" "down"; }
    XF86KbdLightOnOff allow-when-locked=true hotkey-overlay-title="Keyboard backlight cycle" { spawn "omarchy-brightness-keyboard" "cycle"; }
    XF86TouchpadToggle allow-when-locked=true hotkey-overlay-title="Toggle touchpad" { spawn "omarchy-toggle-touchpad"; }
    XF86TouchpadOn allow-when-locked=true hotkey-overlay-title="Enable touchpad" { spawn "omarchy-toggle-touchpad" "on"; }
    XF86TouchpadOff allow-when-locked=true hotkey-overlay-title="Disable touchpad" { spawn "omarchy-toggle-touchpad" "off"; }

    Alt+XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume up precise" { spawn "omarchy-audio-output-volume" "+1"; }
    Alt+XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume down precise" { spawn "omarchy-audio-output-volume" "-1"; }
    Alt+XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness up precise" { spawn "omarchy-brightness-display" "+1%"; }
    Alt+XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness down precise" { spawn "omarchy-brightness-display" "1%-"; }

    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next track" { spawn "omarchy-shell" "media" "next"; }
    Alt+XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Next track" { spawn "omarchy-shell" "media" "next"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Pause" { spawn "omarchy-shell" "media" "playPause"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Play" { spawn "omarchy-shell" "media" "playPause"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "omarchy-shell" "media" "previous"; }
    Alt+Shift+XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "omarchy-shell" "media" "previous"; }
    XF86Eject allow-when-locked=true hotkey-overlay-title="Eject media" { spawn "eject"; }

    Shift+XF86AudioMute allow-when-locked=true hotkey-overlay-title="Switch audio output" { spawn "omarchy-audio-output-switch"; }
    Shift+XF86AudioPause allow-when-locked=true hotkey-overlay-title="Switch media source" { spawn "omarchy-audio-source-switch"; }
    Shift+XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Switch media source" { spawn "omarchy-audio-source-switch"; }

    // ---- Utilities: menus, notifications, screenshots (default/hypr/bindings/utilities.lua) ----
    Mod+Space hotkey-overlay-title="Omarchy menu" { spawn "omarchy-menu" "toggle"; }
    Mod+Alt+Space hotkey-overlay-title="Apps menu" { spawn "omarchy-menu" "toggle" "apps"; }
    Mod+Ctrl+E hotkey-overlay-title="Emojis" { spawn "omarchy-shell" "shell" "toggle" "omarchy.emojis"; }
    Mod+Ctrl+C hotkey-overlay-title="Capture menu" { spawn "omarchy-menu" "toggle" "capture"; }
    Mod+Ctrl+O hotkey-overlay-title="Toggle menu" { spawn "omarchy-menu" "toggle" "toggle"; }
    Mod+Ctrl+H hotkey-overlay-title="Hardware menu" { spawn "omarchy-menu" "toggle" "hardware"; }
    // Hyprland's code:N binds are raw X11 keycodes, which follow the
    // standard X11 convention of evdev keycode + 8 (confirmed against
    // /usr/include/linux/input-event-codes.h: code:20/code:21 here resolve
    // to KEY_MINUS/KEY_EQUAL, i.e. -/=, and code:34/code:35 below resolve to
    // KEY_LEFTBRACE/KEY_RIGHTBRACE, i.e. [/] -- both sensible mnemonics that
    // confirm the offset). code:201 - 8 = evdev 193 = KEY_F23. niri binds by
    // XKB keysym name, not raw keycode, so this becomes the F23 keysym.
    Mod+Shift+F23 hotkey-overlay-title="Omarchy menu" { spawn "omarchy-menu" "toggle" "root"; }
    Mod+Escape hotkey-overlay-title="System menu" { spawn "omarchy-menu" "toggle" "system"; }
    XF86PowerOff allow-when-locked=true hotkey-overlay-title="Power menu" { spawn "omarchy-menu" "toggle" "system"; }
    Mod+K hotkey-overlay-title="Keybindings" { spawn "omarchy-menu-keybindings"; }
    Mod+Alt+K hotkey-overlay-title="Tmux keybindings" { spawn "omarchy-menu-tmux-keybindings"; }
    Mod+Ctrl+K hotkey-overlay-title="Herdr keybindings" { spawn "omarchy-menu-herdr-keybindings"; }
    Mod+Ctrl+Q hotkey-overlay-title="Calculator" { spawn "omacalc"; }
    XF86Calculator hotkey-overlay-title="Calculator" { spawn "omacalc"; }

    // Niri's own hotkey overlay, showing every bind's hotkey-overlay-title
    // above. Niri's default key for this is Mod+Shift+Slash, but that's
    // already taken here by Passwords (omarchy-launch-1password).
    Mod+Ctrl+Slash hotkey-overlay-title="Show keybindings" { show-hotkey-overlay; }

    Mod+Shift+Space hotkey-overlay-title="Toggle top bar" { spawn "omarchy-toggle-bar"; }
    Mod+Ctrl+Space hotkey-overlay-title="Background switcher" { spawn "omarchy-menu" "toggle" "background"; }
    Mod+Shift+Ctrl+Space hotkey-overlay-title="Theme menu" { spawn "omarchy-menu" "toggle" "theme"; }
    Mod+BackSpace hotkey-overlay-title="Toggle window transparency" { spawn "omarchy-hyprland-window-transparency-toggle"; }
    Mod+Shift+BackSpace hotkey-overlay-title="Toggle window gaps" { spawn "omarchy-hyprland-window-gaps-toggle"; }
    Mod+Ctrl+BackSpace hotkey-overlay-title="Toggle single-window square aspect" { spawn "omarchy-hyprland-window-single-square-aspect-toggle"; }

    Mod+Comma hotkey-overlay-title="Dismiss last notification" { spawn "omarchy-shell" "notifications" "dismissOne"; }
    Mod+Shift+Comma hotkey-overlay-title="Dismiss all notifications" { spawn "omarchy-shell" "notifications" "dismissAll"; }
    Mod+Ctrl+Comma hotkey-overlay-title="Toggle silencing notifications" { spawn "omarchy-toggle-notification-silencing"; }
    Mod+Alt+Comma hotkey-overlay-title="Invoke last notification" { spawn "omarchy-shell" "notifications" "invokeLast"; }
    Mod+Shift+Alt+Comma hotkey-overlay-title="Open notification history" { spawn "omarchy-shell" "notifications" "showHistory"; }

    Mod+Ctrl+I hotkey-overlay-title="Toggle locking on idle" { spawn "omarchy-toggle-idle"; }
    Mod+Ctrl+N hotkey-overlay-title="Toggle nightlight" { spawn "omarchy-toggle-nightlight"; }
    Mod+Ctrl+Delete hotkey-overlay-title="Toggle laptop display" { spawn "omarchy-hyprland-monitor-internal" "toggle"; }
    Mod+Ctrl+Alt+Delete hotkey-overlay-title="Toggle laptop display mirroring" { spawn "omarchy-hyprland-monitor-internal-mirror" "toggle"; }
    // Lid switch binds (switch:on:"Lid Switch" / switch:off:"Lid Switch")
    // are ported above as a top-level switch-events{} node, not here -- see
    // the comment at the top of this file.

    Print hotkey-overlay-title="Screenshot" { spawn "omarchy-capture-screenshot"; }
    Alt+Print hotkey-overlay-title="Screenrecording" { spawn-sh "omarchy-capture-screenrecording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord"; }
    // code:34/code:35 -> evdev 26/27 (X11 keycode - 8) -> KEY_LEFTBRACE /
    // KEY_RIGHTBRACE, i.e. the [ and ] keys (see the code:201 note above for
    // the evdev+8 derivation this relies on).
    Mod+Alt+bracketleft hotkey-overlay-title="Make webcam overlay smaller" { spawn "omarchy-capture-webcam-resize" "smaller"; }
    Mod+Alt+bracketright hotkey-overlay-title="Make webcam overlay larger" { spawn "omarchy-capture-webcam-resize" "larger"; }
    Mod+Print hotkey-overlay-title="Color picker" { spawn-sh "pkill hyprpicker || hyprpicker -a"; }
    Mod+Ctrl+Print hotkey-overlay-title="Extract text (OCR) from screenshot" { spawn "omarchy-capture-text"; }

    Mod+Ctrl+S hotkey-overlay-title="Share" { spawn "omarchy-menu" "toggle" "share"; }

    Mod+Ctrl+Period hotkey-overlay-title="Transcode" { spawn "omarchy-transcode"; }

    Mod+Ctrl+R hotkey-overlay-title="Set reminder" { spawn "omarchy-menu" "toggle" "reminder-set"; }
    Mod+Ctrl+Alt+R hotkey-overlay-title="Show reminders" { spawn "omarchy-reminder" "show"; }
    Mod+Shift+Ctrl+R hotkey-overlay-title="Clear reminders" { spawn "omarchy-reminder" "clear"; }

    Mod+Ctrl+Alt+T hotkey-overlay-title="Show time" { spawn "omarchy-notification-time"; }
    Mod+Ctrl+Alt+B hotkey-overlay-title="Show battery remaining" { spawn "omarchy-notification-battery"; }
    Mod+Ctrl+Alt+W hotkey-overlay-title="Toggle weather" { spawn "omarchy-notification-weather"; }

    Mod+Shift+Ctrl+A hotkey-overlay-title="Agent" { spawn "omarchy-agent" "--pick"; }
    Mod+Ctrl+A hotkey-overlay-title="Audio" { spawn "omarchy-shell" "shell" "toggle" "omarchy.audio"; }
    Mod+Ctrl+B hotkey-overlay-title="Bluetooth" { spawn "omarchy-shell" "shell" "toggle" "omarchy.bluetooth"; }
    Mod+Ctrl+D hotkey-overlay-title="Display" { spawn "omarchy-shell" "shell" "toggle" "omarchy.monitor"; }
    Mod+Ctrl+Alt+D hotkey-overlay-title="Calendar" { spawn "omarchy-shell" "shell" "toggle" "omarchy.clock"; }
    Mod+Ctrl+W hotkey-overlay-title="Network" { spawn "omarchy-shell" "shell" "toggle" "omarchy.network"; }
    Mod+Ctrl+P hotkey-overlay-title="Power" { spawn "omarchy-shell" "shell" "toggle" "omarchy.power"; }
    Mod+Ctrl+T hotkey-overlay-title="Activity" { spawn "omarchy-launch-tui" "btop"; }

    // The letters above name a panel; the numbers count them. 1 is the
    // leftmost panel in the bar's right section, and a widget with no panel
    // of its own (the tray) is not counted, so the number matches the icon a
    // user would point at. A bar with fewer panels than this leaves the tail
    // of the range doing nothing. code:(panel+9) uses the same evdev+8
    // keycode convention noted above: code:10..code:18 -> evdev 2..10 ->
    // KEY_1..KEY_9, the physical top-row digit keys 1-9.
    Mod+Ctrl+1 hotkey-overlay-title="Bar panel 1" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "1"; }
    Mod+Ctrl+2 hotkey-overlay-title="Bar panel 2" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "2"; }
    Mod+Ctrl+3 hotkey-overlay-title="Bar panel 3" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "3"; }
    Mod+Ctrl+4 hotkey-overlay-title="Bar panel 4" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "4"; }
    Mod+Ctrl+5 hotkey-overlay-title="Bar panel 5" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "5"; }
    Mod+Ctrl+6 hotkey-overlay-title="Bar panel 6" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "6"; }
    Mod+Ctrl+7 hotkey-overlay-title="Bar panel 7" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "7"; }
    Mod+Ctrl+8 hotkey-overlay-title="Bar panel 8" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "8"; }
    Mod+Ctrl+9 hotkey-overlay-title="Bar panel 9" { spawn "omarchy-shell" "-q" "shell" "togglePanelAt" "right" "9"; }

    // Mod+Ctrl+Z ("Zoom in") and Mod+Ctrl+Alt+Z ("Reset zoom") aren't
    // ported: both call hl.get_config()/hl.config() directly to bump
    // Hyprland's own live cursor.zoom_factor setting -- a Hyprland Lua-API
    // call, not a shell command -- and niri has no equivalent live
    // cursor-zoom action or config knob to call instead.

    Mod+Ctrl+L hotkey-overlay-title="Lock system" { spawn "omarchy-system-lock"; }

    // ---- Voice dictation (default/hypr/bindings/voxtype.lua) ----
    // The following voxtype bindings are unconditional here; Hyprland's
    // config gates them on o.cmd_present("voxtype") (a runtime PATH check
    // for whether the voxtype binary is installed), which this static file
    // can't replicate. Revisit if that ever needs porting.
    Mod+Ctrl+X hotkey-overlay-title="Toggle dictation" { spawn "voxtype" "record" "toggle"; }
    F9 hotkey-overlay-title="Start dictation (push-to-talk)" { spawn "voxtype" "record" "start"; }
    // F9's stop-on-release bind ("voxtype record stop", { release = true })
    // has no niri equivalent: niri's bind schema (niri-config/src/binds.rs,
    // the Bind/Trigger types) only has press-triggered binds with optional
    // repeat/cooldown-ms/allow-when-locked/allow-inhibiting properties --
    // there is no key-release trigger concept at all. Not ported; the
    // Mod+Ctrl+X toggle above is the only way to stop dictation under niri.

    // ---- Window management (default/hypr/bindings/tiling.lua) ----
    // Niri's scrollable-tiling model is structurally different from
    // Hyprland's dwindle/master layout, so this section follows niri's own
    // idioms (and niri's own default-config.kdl key layout, fetched from
    // this project's dev VM) rather than forcing a literal key-for-key
    // port. Every action name below is confirmed against
    // `niri msg action --help` on the dev VM, not guessed.

    // Directional column/window focus -- both arrows and hjkl bound to the
    // same actions, matching niri's own default-config.kdl precedent.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-down; }
    // Mod+K, the fourth hjkl key of this set (focus-window-up), is skipped:
    // Mod+K is already bound above to the Keybindings menu (utilities.lua),
    // and niri rejects a key combo bound twice. Mod+Up still reaches
    // focus-window-up.

    // Directional column/window move -- niri's own real equivalent of
    // tiling.lua's SUPER+SHIFT+arrow "swap window" binds (see the drop-list
    // comment below for why this isn't a true swap). Same Mod+Ctrl+arrows
    // layout as niri's own default-config.kdl. Only J is free of this set's
    // hjkl keys -- H/K/L are already bound above to the Hardware menu, Herdr
    // keybindings, and Lock system (utilities.lua, Task 2) -- so those three
    // are skipped rather than double-bound; the arrow keys still cover all
    // four directions.
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+J     { move-window-down; }

    // Directional monitor focus, same arrows+hjkl pattern, following niri's
    // own default-config.kdl key choice (Mod+Shift+...) since tiling.lua has
    // no directional monitor-focus bind of its own to preserve a key from.
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }

    // tiling.lua's actual monitor-focus bind ("Focus on next/previous
    // monitor", a relative cycle, not directional) keeps its original key
    // combo, translated to niri's own relative equivalents.
    Ctrl+Alt+Tab       { focus-monitor-next; }
    Ctrl+Alt+Shift+Tab { focus-monitor-previous; }

    // Workspace-by-number. Niri's dynamic workspace model still accepts a
    // plain integer index (see `focus-workspace`'s own --help), so this
    // ports directly; tiling.lua's loop goes up to 10, so Mod+0/Shift+0
    // cover the 10th the same way its code:19 (physical "0" key) did.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }
    // tiling.lua's third variant of this loop, Mod+Shift+Alt+<N> ("move
    // window silently to workspace", follow = false, i.e. focus stays put),
    // has no niri equivalent -- move-column-to-workspace always switches
    // focus to the target workspace. Not ported.

    // Next/previous/former workspace. Niri's dynamic workspace model has no
    // exact "e+1"/"e-1"/"previous" like Hyprland's; focus-workspace-down/up
    // is niri's own next/previous idiom, and focus-workspace-previous is
    // its "former workspace" equivalent.
    Mod+Tab       { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Mod+Ctrl+Tab  { focus-workspace-previous; }
    // Scroll-wheel equivalent of the same next/previous idiom, ported from
    // niri's own default-config.kdl example (cooldown-ms avoids scrolling
    // through workspaces too fast) -- matches tiling.lua's
    // SUPER+mouse_down/mouse_up "scroll active workspace forward/backward".
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Move a whole workspace to an adjacent monitor.
    Mod+Shift+Alt+Left  { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+Up    { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Down  { move-workspace-to-monitor-down; }

    // Fullscreen, floating, close. Mod+F matches Hyprland's own Mod+F
    // ("Full screen") for muscle memory.
    Mod+F { fullscreen-window; }
    // Mod+Ctrl+F ("Tiled full screen" in tiling.lua) does have a real niri
    // equivalent after all: omarchy-hyprland-window-tiled-fullscreen-toggle
    // uses fullscreenstate 0 2 (window stays tiled, app is just told it's
    // fullscreen), which is exactly niri's toggle-windowed-fullscreen
    // ("Toggle windowed (fake) fullscreen on the focused window", confirmed
    // via `niri msg action toggle-windowed-fullscreen --help`).
    Mod+Ctrl+F { toggle-windowed-fullscreen; }
    // "Full width" (Mod+Alt+F in tiling.lua) maximizes the window's column
    // width while it stays part of the tiling layout -- niri's real
    // equivalent for that is maximize-column, not fullscreen-window.
    Mod+Alt+F { maximize-column; }
    Mod+T { toggle-window-floating; }
    Mod+W { close-window; }

    // Percentage-based resize. Hyprland's config has three pixel-amount
    // tiers (plain/Alt "a little"/Ctrl "a lot"); niri's set-column-width and
    // set-window-height take a percentage instead of a pixel count, which
    // doesn't split into three tiers the same way, so this uses one
    // reasonable default percentage rather than inventing arbitrary tiers.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Consume/expel: niri's own idiom for moving a window in and out of a
    // column, with no Hyprland concept to translate from. Bound anyway
    // since it's core to niri's tiling model, using niri's own suggested
    // keys.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Monitor scaling: no omarchy-niri-monitor-scaling script existed
    // before this task, so bin/omarchy-niri-monitor-scaling was added
    // alongside this file, following omarchy-hyprland-monitor-scaling's own
    // up/down/direct-value structure but built on `niri msg output <name>
    // scale <value>` instead of hyprctl.
    Mod+Slash     hotkey-overlay-title="Monitor scaling up" { spawn "omarchy-niri-monitor-scaling" "up"; }
    Mod+Alt+Slash hotkey-overlay-title="Monitor scaling down" { spawn "omarchy-niri-monitor-scaling" "down"; }

    // Mouse-drag move/resize (tiling.lua's SUPER+mouse:272/273) needs no
    // bind entry: niri moves/resizes windows on Mod+Left-drag/Mod+Right-drag
    // as fixed built-in input handling, not a configurable bind action (no
    // matching action exists in `niri msg action --help`).

    // The following Hyprland tiling.lua bindings have no Niri
    // equivalent and are intentionally not ported (see
    // docs/superpowers/specs/2026-08-25-omarchy-niri-config-design.md,
    // "Explicitly dropped: no real niri equivalent"):
    //   - Window grouping (Mod+G, Mod+Alt+G, Mod+Alt+Left/Right/Up/Down
    //     into-group, Mod+Alt+Tab group-cycle, Mod+Ctrl+Left/Right
    //     grouped-focus, plus this file's Mod+Alt+Shift+Tab group-prev,
    //     Mod+Alt+mouse_down/up group-cycle, and Mod+Alt+code:10-14
    //     switch-to-group-window binds) -- niri only has tabbed *columns*, a
    //     structurally different, column-scoped concept.
    //   - Scratchpad (Mod+S toggle, Mod+Alt+S move-to-scratchpad) -- niri
    //     has no floating hidden-workspace concept.
    //   - Dwindle/pseudo-tiling toggle (Mod+J toggle-split, Mod+P
    //     pseudo) -- niri has one layout model, no alternate layouts.
    //     (Mod+J is reused above for focus-window-down, niri's own idiom.)
    //   - Workspace-layout save/restore (Mod+L) and everything in
    //     default/hypr/workspace-layouts.lua -- same reason, niri has no
    //     per-workspace layout concept to save/restore at all. (Mod+L is
    //     reused above for focus-column-right, niri's own idiom.)
    //   - Window swap (Mod+Shift+Left/Right/Up/Down) -- no true "swap two
    //     windows" binding is ported. The directional move-column/
    //     move-window binds above (Mod+Ctrl+arrows) now cover the same
    //     underlying need (repositioning a window/column) under niri's own
    //     idiom, per the design spec. Niri does have real
    //     swap-window-left/right actions for the horizontal axis (confirmed
    //     via `niri msg action --help`), but Mod+Shift+Left/Right is
    //     already used above for focus-monitor-left/right, following niri's
    //     own suggested layout, and there is no swap-window-up/down at all;
    //     swap-window-left/right isn't bound anywhere, to avoid a misleading
    //     partial translation of a 4-direction Hyprland binding down to 2
    //     directions on a conflicting key.
    //   - "Close all windows" (Ctrl+Alt+Delete, no Mod) -- no niri action
    //     closes every window at once.
    //   - "Pop window out" (Mod+O; float + pin + raise-to-top) and window-
    //     width save/restore (Mod+Alt+Home save, Mod+Home restore) -- both
    //     are omarchy-hyprland-window-* scripts built entirely on hyprctl
    //     pin/z-order/resize-probing, Hyprland-internals-specific with no
    //     niri concept (window pinning, z-order) to call instead.
    //   - Alt-Tab window cycling (Alt+Tab/Alt+Shift+Tab cycle_next/prev and
    //     bring_to_top) -- niri has no full MRU window-cycle or
    //     bring-to-front/z-order action; the closest, focus-window-previous,
    //     only toggles back to the single last-focused window with no
    //     forward direction, different enough behavior that mapping it here
    //     would be misleading.

    // ---- Clipboard (default/hypr/bindings/clipboard.lua) ----
    Mod+Ctrl+V hotkey-overlay-title="Clipboard manager" { spawn "omarchy-shell" "shell" "toggle" "omarchy.clipboard"; }

    // Mod+C (universal copy), Mod+V (universal paste), Mod+X (universal
    // cut) from default/hypr/bindings/clipboard.lua are NOT ported.
    // Hyprland's version uses synthetic key-state injection
    // (hl.dsp.send_key_state) to distinguish terminal-vs-GUI Ctrl+C/V
    // behavior and reach both normal windows and layer-shell surfaces --
    // niri's IPC has no equivalent "send this key combo to the focused
    // surface" action. See
    // docs/superpowers/specs/2026-08-25-omarchy-niri-config-design.md.

    // default/hypr/bindings/utilities.lua also dynamically binds
    // RETURN/CTRL+RETURN/TAB/CTRL+TAB/arrow-keys while
    // omarchy-capture-region's slurp-based selection overlay is open
    // (via Hyprland's layer.opened/layer.closed events). No niri
    // equivalent event exists to replicate this. Whether
    // omarchy-capture-region needs this at all under niri is a separate,
    // later investigation -- not solved here.
}
