// Omarchy defaults for Niri. Don't edit this file directly — put
// personal overrides in ~/.config/niri/overrides.kdl instead (created
// once by omarchy-refresh-niri if missing, never touched again — see
// docs/superpowers/specs/2026-08-25-omarchy-niri-config-design.md).

// Hyprland's misc.allow_session_lock_restore has no niri equivalent —
// this is the config-side half of the already-documented,
// still-unsolved stranded-lock recovery gap (see this project's own
// memory/status notes and
// docs/superpowers/specs/2026-08-23-omarchy-niri-design.md's "Known
// open risk"). Not solved by this plan.

// key_press_enables_dpms / mouse_move_enables_dpms (Hyprland's DPMS-
// wake-on-input settings) are not configured here. This project's idle
// handling already uses the standard ext-idle-notify-v1 protocol under
// Niri (confirmed working), which may already cover this with no
// explicit config needed. Verify live in the VM (see this plan's
// closing Verification section) before adding explicit config here.

// looknfeel.lua's misc.focus_on_activate, misc.anr_missed_pings,
// misc.on_focus_under_fullscreen, and misc.initial_workspace_tracking
// are Hyprland-internal behavior tuning with no matching node anywhere
// in niri's KDL schema (confirmed via a full node-name dump of the niri
// binary on the project's dev VM) — niri already honors xdg-activation
// focus requests by default. Dropped, no niri equivalent; not owned by
// any other task in this project's Niri config plan either.

input {
    // sensitivity = 0 in input.lua matches niri's own accel-speed
    // default (0.0) — nothing to port there. follow_mouse = 1 is
    // different: Hyprland's docs define mode 1 as "cursor movement will
    // always change focus to the window under the cursor," and
    // input.lua never overrides that default, so it's real, live
    // focus-follows-mouse behavior Omarchy ships today — not a no-op
    // default. niri ships focus-follows-mouse commented out (disabled)
    // by default (see /usr/share/doc/niri/default-config.kdl), so it
    // needs an explicit line here to preserve Hyprland's actual
    // behavior. Using the bare node with no max-scroll-amount: that
    // option only restricts the effect to windows already fully on
    // screen, a stricter behavior Hyprland's follow_mouse = 1 has no
    // equivalent restriction for.
    focus-follows-mouse

    keyboard {
        xkb {
            // Layout/variant/model/rules are left unset deliberately:
            // niri fetches those from org.freedesktop.locale1
            // automatically when unset. Only add them explicitly if
            // live testing shows that doesn't pick up the right layout.

            // options is set explicitly (unlike layout/variant above)
            // because it's a hardcoded Omarchy customization in
            // input.lua's kb_options, not something derived from system
            // locale: CapsLock becomes the compose key, with a
            // Shift+Shift safety-cancel (both_capslock_cancel) that
            // clears an accidental Caps Lock misfire.
            options "compose:caps,shift:both_capslock_cancel"

            // Open question — non-Latin keyboard layouts: input.lua
            // additionally prepends "us," to kb_layout and appends
            // ",grp:alts_toggle" to kb_options when the detected layout
            // isn't Latin-scripted (see its non_latin_layouts list),
            // because "Hyprland resolves keybindings against the first
            // entry in kb_layout, not the layout that's currently
            // active." niri's own resolution isn't identical — per
            // niri's docs it searches *all* configured XKB layouts for
            // the first one containing the needed Latin key, rather
            // than requiring a Latin layout to be listed first — but
            // the failure mode is the same when no Latin layout is
            // configured at all: a user whose only layout is non-Latin
            // (which is what the automatic locale1 pickup above would
            // give them) would still find Mod+<letter> binds like
            // Mod+Q unresolvable, same as Hyprland without its
            // workaround.
            //
            // Porting the fix isn't a plain copy: input.lua computes
            // this per-launch in a live Lua script that reads
            // /etc/vconsole.conf, while this config.kdl is a static
            // file shipped as-is — niri has no per-launch KDL
            // generation step analogous to that (bin/omarchy-refresh-
            // niri only regenerates the include pointer, not layout
            // content). Doing this properly needs a generation
            // mechanism this project doesn't have yet, which is out of
            // scope here. Left unimplemented pending that decision;
            // verify live with a non-Latin layout in the VM first.
        }

        numlock
        repeat-rate 40
        repeat-delay 250
    }

    touchpad {
        tap
        click-method "clickfinger"
        scroll-factor 0.4
    }
}

// looknfeel.lua's general.layout = "dwindle" is Hyprland's active tiling
// algorithm, but niri has exactly one layout model (scrollable columns)
// with no per-workspace choice between algorithms to port dwindle to —
// dropped, no niri equivalent (not "dead config"; see bindings.kdl's
// "Explicitly dropped" list for the SUPER+L toggle this feeds).
// looknfeel.lua's scrolling{} block configures Hyprland's *other* tiling
// algorithm, reachable live via SUPER+L
// (bin/omarchy-hyprland-workspace-layout-toggle, persisted per-workspace
// by default/hypr/workspace-layouts.lua) — real, live behavior, not
// inert. But niri's own model already IS "always scrolling columns", so
// the per-workspace dwindle/scrolling *choice* Hyprland toggles between
// doesn't exist to preserve either way; the one value from that block
// worth carrying over, column_width, is ported below as
// default-column-width. looknfeel.lua's master.new_status is genuinely
// dead: SUPER+L's toggle only ever selects dwindle or scrolling, never
// master — nothing to port there.
// group{}/groupbar styling (tabbed-window borders/fonts/colors) has no
// niri equivalent either — niri only has tabbed *columns*
// (toggle-column-tabbed-display), a different, column-scoped concept
// (see bindings.kdl's drop list).
// general.resize_on_border and general.allow_tearing also have no niri
// config equivalent (confirmed against niri's full KDL schema on the
// project's dev VM: no matching node exists in either the layout or
// output config) — both are already off/false in this theme, so this is
// moot either way, not a gap.
// niri does support blur, just not as a global layout{} toggle like
// Hyprland's decoration.blur — it's a per-window-rule/layer-rule effect
// instead (window-rule/layer-rule { background-effect { blur true } },
// confirmed valid on the dev VM). Not enabled here since looknfeel.lua
// has blur.enabled = false; noted for whoever writes window-rules.kdl.
layout {
    gaps 8

    // looknfeel.lua's scrolling.column_width = 0.49 — see the comment
    // above; niri's own default is proportion 0.5.
    default-column-width {
        proportion 0.49
    }

    focus-ring {
        off
    }

    border {
        width 2
        // Faithful port of looknfeel.lua's 2-stop 45° active-border
        // gradient (rgba(33ccffee) -> rgba(00ff99ee)), not collapsed to
        // a flat color — a flat approximation would silently drop the
        // second color stop, angle, and alpha, which this plan's own
        // Global Constraints forbid. Overridden live by the theme system
        // the moment it has run (see the include below); this is only
        // the pre-theme-system fallback.
        active-gradient from="#33ccffee" to="#00ff99ee" angle=45
        inactive-color "#595959aa"
    }

    shadow {
        // Matches the current theme's shadow.enabled = false.
    }
}

// looknfeel.lua's cursor.warp_on_change_workspace = 1 has a near-niri-
// equivalent, input { warp-mouse-to-focus mode="center-xy-always" }
// (confirmed valid on the dev VM) — but niri's version warps the mouse
// on every focus change, not just workspace switches, which is broader
// than Hyprland's setting. Deliberately not enabled: it would add
// mouse-jump-on-window-focus behavior Hyprland doesn't have here.
cursor {
    hide-when-typing
}

hotkey-overlay {
    skip-at-startup
}

// default/hypr/autostart.lua's hl.on("hyprland.start", ...) hook runs once
// per Hyprland session start; these spawn-at-startup/spawn-sh-at-startup
// nodes are niri's direct equivalent. omarchy-launch-shell below is what
// closes this project's previously-noted gap: Niri didn't auto-launch the
// Omarchy shell on login, unlike Hyprland.
//
// autostart.lua's own first two commands (systemctl --user
// import-environment / dbus-update-activation-environment) are ported
// verbatim below rather than dropped, despite genuine uncertainty about
// whether they're redundant under niri: niri.service's unit file
// (/usr/lib/systemd/user/niri.service, confirmed on the project's dev VM)
// runs ExecStart=niri --session directly, with no environment import of
// its own. The niri-session wrapper script — what niri.desktop's Exec=
// actually points at, and what `uwsm start -n -g -1 -e -D niri
// niri.desktop` (this project's own omarchy-niri.desktop invocation, dry
// run) resolves "Command Line:" to — does its own systemctl --user
// import-environment + dbus-update-activation-environment dance, but only
// when NOT already launched as a systemd --user service; under uwsm's
// generated wayland-wm@... service (confirmed via that same dry run),
// niri-session takes its early-exit branch straight to `exec niri
// --session`, skipping that dance entirely. Hyprland's own session is
// launched by uwsm exactly the same way (omarchy.desktop: uwsm start ...
// Hyprland hyprland.desktop) and *still* needs this fix per autostart.lua's
// own "Slow app launch fix" comment — real-world evidence that uwsm's own
// environment handling doesn't fully substitute for it. So this is ported
// here as likely necessary, not cargo-culted; running it twice (once via
// niri-session's skipped branch if this analysis is wrong, once via this
// spawn) is harmless either way. Flagged for live confirmation per this
// plan's own closing Verification section.
spawn-sh-at-startup "systemctl --user import-environment $(env | cut -d'=' -f 1) && dbus-update-activation-environment --systemd --all"

spawn-at-startup "omarchy-launch-shell"
spawn-at-startup "omarchy-provision-first-run"
spawn-at-startup "omarchy-powerprofiles-init"
spawn-at-startup "udiskie" "--automount" "--no-notify" "--no-tray"
spawn-sh-at-startup "sleep 2 && omarchy-hook post-boot"

// autostart.lua also runs omarchy-hyprland-monitor-watch (via uwsm-app) on
// every Hyprland session start. Read in full, its actual job is Omarchy's
// clamshell-mode auto-disable of the laptop panel when docked with the lid
// shut and an external monitor active (via hyprctl eval/dispatch, reading
// hypr/monitors.lua), plus a modeless-monitor recovery loop that forces a
// reload when a monitor reports a 0x0-mode EDID after power-on. Both are
// Omarchy-added behaviors built entirely on Hyprland-specific plumbing
// (hyprctl, hypr/monitors.lua, the hypr event socket) — not raw
// hotplug-reactivity that niri's own newer, more first-class multi-monitor
// support would already provide as a side effect. No niri equivalent of
// any of the underlying helpers (omarchy-hyprland-monitor-clamshell,
// -modeless, -external-active, -laptop, -internal, -internal-mirror)
// exists in bin/ today, and porting the feature means rewriting all of
// them against niri's own output config and `niri msg -j event-stream`'s
// output-related events (as this project's NiriService reference,
// shell/plugins/services/niri/Service.qml, already does for its own
// window/workspace/keyboard-layout events) — real, separate script work
// outside this task's scope (config.kdl only, per this task's own Files
// list). Not added here; no startup line calls a script that doesn't
// exist yet.

// Theme colors override the border section above. optional=true means
// this silently no-ops before the theme system has ever run (e.g. right
// after a fresh omarchy dev link), then picks up colors the moment it
// does — same pattern as Hyprland's
// require_optional.module("omarchy.current.theme.hyprland").
include "~/.local/state/omarchy/current/theme/niri.kdl" optional=true

include "bindings.kdl"
include "window-rules.kdl"

include "~/.config/niri/overrides.kdl" optional=true
