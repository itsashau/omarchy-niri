#!/bin/bash

# omarchy:summary=Regenerate the entry point ~/.config/niri/config.kdl points OMARCHY_PATH at
# omarchy:hidden=true

# Niri's `include` has no environment-variable expansion (unlike
# Hyprland's Lua config, which reads $OMARCHY_PATH live via os.getenv on
# every reload) — so unlike Hyprland's static ~/.config/hypr/hyprland.lua,
# this file has to be regenerated whenever OMARCHY_PATH changes, not just
# copied once. Run at the start of every Niri session (see
# default/wayland-sessions/omarchy-niri.desktop) so a dev-link change
# takes effect on next login, with no special-casing needed in
# omarchy-dev-link/omarchy-dev-unlink themselves.
#
# ~/.config/niri/config.kdl itself is fully machine-generated and safe to
# overwrite every login — it is never where personal customization goes.
# Personal overrides belong in ~/.config/niri/overrides.kdl instead
# (included from default/niri/config.kdl with optional=true), which this
# script creates once if missing and never touches again.

: "${OMARCHY_PATH:=/usr/share/omarchy}"

config_path="$OMARCHY_PATH/default/niri/config.kdl"
# KDL string arguments need double quotes, not shell quoting — a plain
# printf %q would produce single-quoted or backslash-escaped output on a
# path with spaces, neither of which is valid KDL. Escape backslashes
# before quotes (order matters: escaping the quote first would
# double-escape the backslash the quote-escape itself introduces), then
# wrap in literal double quotes ourselves.
escaped_path=${config_path//\\/\\\\}
escaped_path=${escaped_path//\"/\\\"}

mkdir -p "$HOME/.config/niri"

config_target="$HOME/.config/niri/config.kdl"
generated_line="include \"$escaped_path\""
overrides="$HOME/.config/niri/overrides.kdl"

# If a config.kdl already exists with content this script wouldn't have
# generated itself (niri's own default, a hand-edit, or a previous
# generated line for a different OMARCHY_PATH), it's real content worth
# preserving rather than silently overwriting.
if [[ -f $config_target ]] && [[ "$(<"$config_target")" != "$generated_line" ]]; then
  if [[ -f $overrides ]]; then
    mv "$config_target" "$config_target.bak.$(date +%s)"
  else
    mv "$config_target" "$overrides"
  fi
fi

printf '%s\n' "$generated_line" > "$config_target"

if [[ ! -f $overrides ]]; then
  cat > "$overrides" <<'EOF'
// Personal Niri config overrides. This file is created once and never
// touched by omarchy-refresh-niri again — edit it freely.
EOF
fi
